# =====================================================================
# 智能教务系统 · 环境变量模板
# 用法：复制本文件为 .env，按需填写；不填任何大模型 Key 时系统自动进入
#       「离线规则模式」(MockLLM)，所有查询/预约功能依然可以演示。
# =====================================================================

DEBUG=true
SECRET_KEY=please-change-me-to-a-random-string
TOKEN_EXPIRE_MINUTES=720

# ---------- 1. 数据库 ----------
# 本地开发（默认，零配置）：SQLite 文件库
# DATABASE_URL=sqlite+aiosqlite:///D:/desktop/edu-agent-system/data/edu.db
# 线上云服务器 · MySQL 8.x（pip install aiomysql pymysql）
# DATABASE_URL=mysql+aiomysql://edu_user:密码@127.0.0.1:3306/edu_system?charset=utf8mb4
# 线上云服务器 · PostgreSQL 14+（pip install asyncpg）
# DATABASE_URL=postgresql+asyncpg://edu_user:密码@127.0.0.1:5432/edu_system

# ---------- 2. 学生端大模型（服务学生） ----------
STUDENT_LLM_MODEL=deepseek-chat
STUDENT_LLM_API_KEY=
STUDENT_LLM_BASE_URL=https://api.deepseek.com/v1
STUDENT_LLM_TEMPERATURE=0.3

# ---------- 3. 教师端大模型（服务老师，可与学生端不同模型） ----------
TEACHER_LLM_MODEL=deepseek-chat
TEACHER_LLM_API_KEY=
TEACHER_LLM_BASE_URL=https://api.deepseek.com/v1
TEACHER_LLM_TEMPERATURE=0.2

# ---------- 4. LangSmith 链路追踪 ----------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=edu-agent-system
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ---------- 5. RAG 向量与检索 ----------
# offline = 本地 TF-IDF（默认，秒启动）；openai = 调 /embeddings（需单独的 Key，DeepSeek 不支持）
EMBEDDING_PROVIDER=offline
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
RAG_TOP_K=4
RAG_CHUNK_SIZE=420
